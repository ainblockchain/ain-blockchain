        "ENABLE_REST_FUNCTION_CALL": "true",
        "TX_POOL_SIZE_LIMIT": "1000000",
        "TX_POOL_SIZE_LIMIT_PER_ACCOUNT": "200000",
        "MAX_NUM_INBOUND_CONNECTION": "12",
        "TARGET_NUM_OUTBOUND_CONNECTION": "9",
        "ENABLE_EVENT_HANDLER": "true",
        "EVENT_HANDLER_PORT": "15101"
      },
      "command": [
        "--max-old-space-size=8192",
        "/app/ain-blockchain/cert-client.js"
      ],
      "volumes": [
        "chain-node9:/data",
        "./cert-client.js:/app/ain-blockchain/cert-client.js:ro"
      ],
      "depends_on": [
        "tracker"
      ],
      "restart": "no",
      "labels": {
        "org.ain.cert.role": "blockchain",
        "org.ain.cert.node": "9",
        "org.ain.cert.allocation": "shared-host-oversubscribed-ceilings"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://localhost:'+process.env.PORT+'/node_status',{signal:AbortSignal.timeout(4000)}).then(response=>response.json()).then(body=>process.exit(body.code===0&&body.result?.state==='SERVING'&&body.result?.health===true?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 18,
        "start_period": "60s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "20m",
          "max-file": "3"
        }
      }
    }
  },
  "volumes": {
    "chain-node0": {},
    "chain-node1": {},
    "chain-node2": {},
    "chain-node3": {},
    "chain-node4": {},
    "chain-node5": {},
    "chain-node6": {},
